---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPublishedProjects } from "../lib/projects";

const projects = await getPublishedProjects();
const featured = projects.filter((p) => p.data.featured);
const shown = (featured.length > 0 ? featured : projects).slice(0, 3);
---

<BaseLayout
  title="Zach Ross"
  description="Zach Ross is a software engineer working on backend systems, data pipelines, and practical AI. Five years at Amazon Music; now building MCP infrastructure for self-hosted LLM assistants."
>
  <section class="intro" aria-labelledby="intro-heading">
    <h1 id="intro-heading">Zach Ross</h1>
    <p class="tagline">Software engineer: backend, data, and practical AI.</p>
    <p class="lede">
      I build the plumbing that lets LLMs work safely with real business
      systems: MCP connectors that give AI assistants access to operational data
      without exposing customer or financial information. Before that, I spent
      five years at Amazon Music building the data pipelines, APIs, and payment
      systems behind music royalties.
    </p>
    <ul class="actions">
      <li>
        <a class="button primary" href="mailto:zach@zachross.io">
          Email me
        </a>
      </li>
      <li>
        <a class="button" href="/projects">
          See projects
        </a>
      </li>
      <li>
        <a class="button" href="/resume.pdf">
          Resume (PDF)
        </a>
      </li>
    </ul>
  </section>

  {shown.length > 0 && (
    <section class="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading">
        {featured.length > 0 ? "Featured projects" : "Recent projects"}
      </h2>
      <ul class="card-list">
        {shown.map((project) => (
          <li>
            <ProjectCard project={project} headingLevel={3} />
          </li>
        ))}
      </ul>
      <p>
        <a href="/projects">All projects</a>
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .intro h1 {
    margin-block: 0 var(--space-2);
  }

  .tagline {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.25rem;
  }

  .lede {
    max-width: 38rem;
    margin-block: var(--space-4);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects {
    margin-top: var(--space-6);
  }
</style>
